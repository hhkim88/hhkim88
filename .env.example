# The debate orchestrator uses claude-agent-sdk, which inherits auth from the
# local Claude Code CLI (Max subscription works — no API key needed).
# Override the default models if you want:
# DEBATE_MODEL=claude-sonnet-4-6
# MODERATOR_MODEL=claude-haiku-4-5

# OpenDART (https://opendart.fss.or.kr - free signup)
DART_API_KEY=

# Reddit (https://reddit.com/prefs/apps - free)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=company-search/0.1

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html - free)
FRED_API_KEY=

# Bank of Korea ECOS (https://ecos.bok.or.kr - free)
ECOS_API_KEY=
